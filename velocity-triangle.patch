+// ─── 速度三角形 SVG コンポーネント ───────────────────────────
+function VelocityTriangleSVG({ tri, label, color }: { tri: VelocityTriangle; label: string; color: string }) {
+  const W = 260, H = 160
+  const CX = 40, CY = 110  // 起点（周速の根元）
+  const SCALE = Math.min(100 / Math.max(tri.u, tri.c, tri.w, 1), 8)
+
+  // 各ベクトルの終点
+  // u: 周方向（右）
+  const ux = CX + tri.u * SCALE, uy = CY
+  // c: 絶対速度（alpha は周方向から）
+  const alphaRad = tri.alpha * Math.PI / 180
+  const cx2 = CX + tri.cu * SCALE, cy2 = CY - tri.cm * SCALE
+  // w: 相対速度（c の終点から u の終点へ）
+  // w = c - u  → w の先端は c の先端、根元は u の先端
+  const wStartX = ux, wStartY = uy
+  const wEndX = cx2, wEndY = cy2
+
+  const arrow = (x1: number, y1: number, x2: number, y2: number, col: string, dash = '') => {
+    const dx = x2 - x1, dy = y2 - y1
+    const len = Math.sqrt(dx * dx + dy * dy)
+    if (len < 2) return null
+    const ax = dx / len, ay = dy / len
+    const hx = x2 - ax * 8, hy = y2 - ay * 8
+    const px = -ay * 4, py = ax * 4
+    return (
+      <g>
+        <line x1={x1} y1={y1} x2={x2} y2={y2} stroke={col} strokeWidth="1.8" strokeDasharray={dash} />
+        <polygon points={`${x2},${y2} ${hx + px},${hy + py} ${hx - px},${hy - py}`} fill={col} />
+      </g>
+    )
+  }
+
+  const fmt = (v: number) => v.toFixed(1)
+
+  return (
+    <svg viewBox={`0 0 ${W} ${H}`} style={{ width: '100%', maxHeight: H, display: 'block' }}>
+      {/* 軸線 */}
+      <line x1={CX - 10} y1={CY} x2={W - 10} y2={CY} stroke="var(--border)" strokeWidth="0.8" strokeDasharray="3 3" />
+      <line x1={CX} y1={10} x2={CX} y2={CY + 10} stroke="var(--border)" strokeWidth="0.8" strokeDasharray="3 3" />
+
+      {/* u: 周速（青） */}
+      {arrow(CX, CY, ux, uy, '#60a5fa')}
+      <text x={(CX + ux) / 2} y={CY + 14} fill="#60a5fa" fontSize="9" textAnchor="middle" fontFamily="JetBrains Mono">
+        u={fmt(tri.u)}
+      </text>
+
+      {/* c: 絶対速度（指定色） */}
+      {arrow(CX, CY, cx2, cy2, color)}
+      <text x={cx2 + 4} y={cy2 - 4} fill={color} fontSize="9" fontFamily="JetBrains Mono">
+        c={fmt(tri.c)}
+      </text>
+
+      {/* w: 相対速度（橙、破線） */}
+      {arrow(wStartX, wStartY, wEndX, wEndY, '#fb923c', '4 2')}
+      <text x={(wStartX + wEndX) / 2 + 6} y={(wStartY + wEndY) / 2} fill="#fb923c" fontSize="9" fontFamily="JetBrains Mono">
+        w={fmt(tri.w)}
+      </text>
+
+      {/* α角弧 */}
+      {tri.cm > 1 && (() => {
+        const r = 18
+        const a1 = 0, a2 = -Math.atan2(tri.cm, tri.cu)
+        const x1a = CX + r, y1a = CY
+        const x2a = CX + r * Math.cos(a2), y2a = CY + r * Math.sin(a2)
+        return (
+          <g>
+            <path d={`M ${x1a} ${y1a} A ${r} ${r} 0 0 1 ${x2a} ${y2a}`} fill="none" stroke={color} strokeWidth="1" opacity="0.5" />
+            <text x={CX + r + 6} y={CY - 4} fill={color} fontSize="8" fontFamily="JetBrains Mono">α={fmt(Math.abs(tri.alpha))}°</text>
+          </g>
+        )
+      })()}
+
+      {/* β角弧 */}
+      {Math.abs(tri.wu) > 0.5 && (() => {
+        const r = 14
+        const betaRad = Math.atan2(tri.cm, Math.abs(tri.wu))
+        const x2b = ux + r * Math.sign(tri.wu), y2b = uy
+        const x1b = ux + r * Math.cos(-betaRad) * Math.sign(tri.wu), y1b = uy + r * Math.sin(-betaRad)
+        return (
+          <g>
+            <path d={`M ${x2b} ${y2b} A ${r} ${r} 0 0 0 ${x1b} ${y1b}`} fill="none" stroke="#fb923c" strokeWidth="1" opacity="0.5" />
+            <text x={ux - 8} y={uy + 22} fill="#fb923c" fontSize="8" fontFamily="JetBrains Mono">β={fmt(Math.abs(tri.beta))}°</text>
+          </g>
+        )
+      })()}
+
+      {/* ラベル */}
+      <text x={W / 2} y={14} fill="var(--muted)" fontSize="9" textAnchor="middle" fontFamily="JetBrains Mono" fontWeight="700" letterSpacing="0.08em">
+        {label}
+      </text>
+    </svg>
+  )
+}
