+// ── 速度三角形ヘルパー ────────────────────────────────────────
+function makeTriangle(u: number, cu: number, cm: number): VelocityTriangle {
+  const c    = Math.sqrt(cu * cu + cm * cm)
+  const wu   = cu - u
+  const w    = Math.sqrt(wu * wu + cm * cm)
+  const alpha = Math.atan2(cm, cu) * 180 / PI   // α: 絶対速度と周方向の角度 [deg]
+  const beta  = Math.atan2(cm, wu) * 180 / PI   // β: 相対速度と周方向の角度 [deg]
+  return { u, c, w, alpha, beta, cu, cm, wu }
+}
+
+// ── ペルトン速度三角形 ─────────────────────────────────────────
+// 衝動式：ジェット速度 c1 = Cv√(2gH)、バケット周速 u = 0.46√(2gH)
+function calcPeltonVelocityTriangles(head: number, ratedRpm: number, runnerDiameter: number) {
+  const Cv = 0.97
+  const c1 = Cv * Math.sqrt(2 * G * head)   // ジェット絶対速度
+  const u  = (PI * runnerDiameter * ratedRpm) / 60
+
+  // 入口：ジェットが水平に当たる（α1 ≒ 0°）
+  const inletCu = c1
+  const inletCm = 0                          // 子午面成分は微小と近似
+  const inlet   = makeTriangle(u, inletCu, inletCm)
+
+  // 出口：バケット出口偏向角 β2≒165°（損失考慮）、速度係数 k=0.9
+  const beta2Rad = (180 - 165) * PI / 180   // バケット相対出口角（基準から）
+  const k        = 0.90
+  const w1       = Math.abs(inlet.wu)        // 入口相対速度
+  const w2       = k * w1
+  const outletWu = -w2 * Math.cos(beta2Rad)  // 周方向成分（逆向き）
+  const outletCm =  w2 * Math.sin(beta2Rad)
+  const outletCu = u + outletWu
+  const outlet   = makeTriangle(u, outletCu, outletCm)
+
+  return { inlet, outlet }
+}
+
+// ── フランシス速度三角形 ───────────────────────────────────────
+// 参考：IEC 60193 / 水車設計標準
+function calcFrancisVelocityTriangles(
+  head: number, flowRate: number, specificSpeed: number,
+  ratedRpm: number, runnerDiameter: number,
+) {
+  const r1 = runnerDiameter / 2                  // 入口半径
+  const u1  = (PI * 2 * r1 * ratedRpm) / 60
+
+  // 入口子午面速度（ガイドベーン出口 = ランナー入口）
+  // cm1 ≈ Q / (π × D1 × b1)、b1 = guideVaneHeight を近似
+  const b1  = runnerDiameter * 0.18 * Math.pow(specificSpeed / 100, 0.45)
+  const cm1 = flowRate / (PI * runnerDiameter * b1)
+
+  // 設計点：入口では通常 α1 ≈ 15〜30°
+  // cu1 = u1 - cm1/tan(β1)、β1 は比速度から推算
+  const beta1_deg = 55 + 30 * (specificSpeed - 80) / 220   // Ns80→55°, Ns300→85° に線形補間
+  const beta1_rad = beta1_deg * PI / 180
+  const cu1 = u1 - cm1 / Math.tan(beta1_rad)
+  const inlet = makeTriangle(u1, cu1, cm1)
+
+  // 出口（ランナー出口：設計点では渦なし cu2 ≈ 0 が理想）
+  const r2  = runnerDiameter * 0.72 / 2          // 出口は内径側（概略）
+  const u2  = (PI * 2 * r2 * ratedRpm) / 60
+  // 出口面積は吸出し管径から
+  const draftD = Math.sqrt(4 * flowRate / (PI * 4.0))
+  const cm2    = flowRate / (PI * (draftD / 2) ** 2)
+  const cu2    = 0                               // 設計点：渦なし出口
+  const outlet = makeTriangle(u2, cu2, cm2)
+
+  return { inlet, outlet }
+}
+
+// ── カプラン / チューブラ速度三角形（軸流型共通） ─────────────
+function calcAxialVelocityTriangles(
+  head: number, flowRate: number, specificSpeed: number,
+  ratedRpm: number, runnerDiameter: number, hubRatio: number,
+) {
+  // 代表半径 = ピッチ半径 (r_hub + r_tip) / 2
+  const rTip = runnerDiameter / 2
+  const rHub = rTip * hubRatio
+  const rMean = (rTip + rHub) / 2
+  const u1 = (PI * 2 * rMean * ratedRpm) / 60
+
+  // 入口子午面速度（スラスト面積）
+  const thrustArea = PI * (rTip ** 2 - rHub ** 2)
+  const cm1 = flowRate / thrustArea
+
+  // 入口絶対速度の周方向成分：ユーラー方程式から
+  // gH = u1×cu1 − u2×cu2、設計点 cu2=0 として cu1 = gH/u1
+  const cu1 = (G * head) / u1
+  const inlet = makeTriangle(u1, cu1, cm1)
+
+  // 出口：設計点 cu2 ≈ 0（渦なし）
+  const cm2 = cm1                               // 子午面速度は保存
+  const outlet = makeTriangle(u1, 0, cm2)
+
+  return { inlet, outlet }
+}
+
+// ── クロスフロー速度三角形（Banki-Michell型） ─────────────────
+// 入口（外周）→ 出口（内周）の2段流れを近似
+function calcCrossflowVelocityTriangles(
+  head: number, flowRate: number,
+  ratedRpm: number, runnerDiameter: number, runnerWidth: number,
+) {
+  // 周速（外径基準）
+  const u = (PI * runnerDiameter * ratedRpm) / 60
+
+  // 入口：入射角 α1 ≈ 16°（設計値）
+  const alpha1_deg = 16
+  const alpha1_rad = alpha1_deg * PI / 180
+  const c1 = 0.98 * Math.sqrt(2 * G * head)    // 流速係数 Cv=0.98
+  const cu1 = c1 * Math.cos(alpha1_rad)
+  const cm1 = c1 * Math.sin(alpha1_rad)
+  const inlet = makeTriangle(u, cu1, cm1)
+
+  // 出口（内側ランナー出口）：内径 D2 ≈ 0.66×D1
+  const u2  = u * 0.66
+  const cm2 = cm1 * 1.1                        // 内径側で流速やや増加
+  const cu2 = 0                                 // 設計点：残留旋回なし近似
+  const outlet = makeTriangle(u2, cu2, cm2)
+
+  return { inlet, outlet }
+}
